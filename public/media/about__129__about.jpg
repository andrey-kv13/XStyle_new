80="707" data-artboard-height-res-640="757"> <div class="t396__carrier" data-artboard-recid="1107005046"></div> <div class="t396__filter" data-artboard-recid="1107005046"></div> <div class='t396__elem tn-elem tn-elem__11070050461750112430704' data-elem-id='1750112430704' data-elem-type='text' data-field-top-value="110" data-field-left-value="547" data-field-height-value="17" data-field-width-value="527" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-textfit-value="autoheight" data-field-fontsize-value="19" data-field-top-res-320-value="48" data-field-left-res-320-value="20" data-field-width-res-320-value="280" data-field-fontsize-res-320-value="9" data-field-width-res-480-value="434" data-field-top-res-640-value="54" data-field-left-res-640-value="20" data-field-width-res-640-value="600" data-field-top-res-960-value="114" data-field-left-res-960-value="547" data-field-height-res-960-value="168" data-field-width-res-960-value="367" data-field-container-res-960-value="grid" data-field-heightunits-res-960-value="px" data-field-textfit-res-960-value="autoheight"> <div class='tn-atom'field='tn_text_1750112430704'>Мы&nbsp;верим, что мебель&nbsp;— это не&nbsp;просто предмет, а&nbsp;часть жизни, отражающая характер дома и&nbsp;его хозяев. Именно поэтому для нас важны натуральные материалы, продуманный дизайн и&nbsp;высокое качество исполнения.<br /><br />Каждое изделие в&nbsp;нашем ассортименте отбирается с&nbsp;вниманием<br />к&nbsp;деталям и&nbsp;уважением к&nbsp;ремеслу. Мы&nbsp;стремимся создавать пространство, в&nbsp;котором будет комфортно жить, работать и&nbsp;отдыхать.<br /><br />Наша философия&nbsp;— сочетать эстетику и&nbsp;практичность, опираясь на&nbsp;опыт, традиции и&nbsp;любовь к&nbsp;своему делу.</div> </div> <div class='t396__elem tn-elem tn-elem__11070050461750112430710' d